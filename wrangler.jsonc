{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nurseprep",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nurseprep-db",
      "database_id": "0fc9e910-c42a-421b-8b7b-5edefc8bb539"
    }
  ]
}